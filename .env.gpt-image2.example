# Optional bootstrap configuration; the page also offers "生图设置".
# Copy to .env.gpt-image2 and fill locally. Saved UI settings take precedence.
GPT_IMAGE2_1_BASE_URL=https://api.openai.com/v1
GPT_IMAGE2_1_API_KEY=
GPT_IMAGE2_1_MODELS=gpt-image-2
# Remote requests require an explicit HTTP/HTTPS/SOCKS proxy URL.
GPT_IMAGE2_1_PROXY_URL=
