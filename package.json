{
  "name": "test-driven-study",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "course:new": "go run ./cmd/course new",
    "course:check": "go run ./cmd/course check",
    "course:install": "go run ./cmd/course install",
    "issue:new": "node scripts/issue-new.mjs",
    "issue:check": "node scripts/issue-check.mjs",
    "issue:worktree": "node scripts/issue-worktree.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "go run ./cmd/server",
    "build": "npm run typecheck && vite build && node scripts/build-api.mjs",
    "start": "node scripts/start.mjs",
    "generate:api": "openapi-ts",
    "generate:db": "node scripts/generate-db.mjs",
    "generate": "npm run generate:api && npm run generate:db",
    "format:go": "gofmt -w cmd internal",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:go": "go test ./...",
    "test:e2e": "playwright test",
    "check": "npm run issue:check && npm run check:generated && npm run test:unit && npm run test:go && npm run test:startup && npm run build && npm run test:e2e",
    "check:generated": "node scripts/check-generated.mjs",
    "dev:up": "node scripts/dev-process.mjs up",
    "dev:down": "node scripts/dev-process.mjs down",
    "dev:status": "node scripts/dev-process.mjs status",
    "test:startup": "node --test tests/startup/dev-process.test.mjs"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.33",
    "@assistant-ui/react-markdown": "0.14.25",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.2"
    }
  }
}
