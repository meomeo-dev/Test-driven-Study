{
  "protocol_version": 1,
  "course_id": "applied-machine-learning",
  "version": "1.1.0",
  "title": "机器学习与工业质检",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "机器学习与质检任务",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "机器学习与质检任务",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "ml-problem-framing",
          "title": "机器学习任务类型",
          "summary": "监督学习与无监督学习，分类与回归，训练与预测，何时不需要机器学习",
          "estimated_minutes": 65,
          "lesson": "intro"
        },
        {
          "id": "rule-baseline",
          "title": "规则法基线",
          "summary": "用阈值和规则建立基线，基线的作用，模型必须在同一测试集上胜过基线",
          "estimated_minutes": 55,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "ml-problem-framing"
              ]
            }
          ]
        },
        {
          "id": "features-labels",
          "title": "特征、标签与样本",
          "summary": "样本、特征向量、标签，特征矩阵 X 的形状 (样本数, 特征数)，从图像提取数值特征",
          "estimated_minutes": 70,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "ml-problem-framing"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "data",
      "title": "数据与标注",
      "question_file": "questions/data.json",
      "lessons": [
        {
          "id": "data",
          "title": "数据与标注",
          "file": "lessons/data.md"
        }
      ],
      "concepts": [
        {
          "id": "labeling",
          "title": "缺陷标注规范",
          "summary": "类别定义与示例，标注一致性，难判样本的处理，标注错误的影响",
          "estimated_minutes": 70,
          "lesson": "data",
          "prerequisites": [
            {
              "all_of": [
                "features-labels"
              ]
            }
          ]
        },
        {
          "id": "data-splits",
          "title": "训练、验证与测试划分",
          "summary": "三种数据集的用途，按工件或批次划分，同一工件的多张照片不能跨集合，数据泄漏",
          "estimated_minutes": 85,
          "lesson": "data",
          "prerequisites": [
            {
              "all_of": [
                "features-labels"
              ]
            }
          ]
        },
        {
          "id": "class-imbalance",
          "title": "类别不平衡",
          "summary": "缺陷样本很少时准确率失真，分层划分，类别权重与重采样",
          "estimated_minutes": 65,
          "lesson": "data",
          "prerequisites": [
            {
              "all_of": [
                "data-splits"
              ]
            }
          ]
        },
        {
          "id": "feature-scaling",
          "title": "特征缩放与预处理",
          "summary": "标准化与归一化，缩放参数只用训练集拟合，缺失值处理",
          "estimated_minutes": 65,
          "lesson": "data",
          "prerequisites": [
            {
              "all_of": [
                "features-labels"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "models",
      "title": "基础模型",
      "question_file": "questions/models.json",
      "lessons": [
        {
          "id": "models",
          "title": "基础模型",
          "file": "lessons/models.md"
        }
      ],
      "concepts": [
        {
          "id": "knn",
          "title": "k 近邻",
          "summary": "距离计算，k 的选择，多数投票，特征尺度对距离的影响",
          "estimated_minutes": 70,
          "lesson": "models",
          "prerequisites": [
            {
              "all_of": [
                "feature-scaling"
              ]
            }
          ]
        },
        {
          "id": "logistic-regression",
          "title": "逻辑回归与概率输出",
          "summary": "线性组合加 sigmoid 函数 1/(1 + e^(−z))，输出缺陷概率，默认阈值 0.5",
          "estimated_minutes": 85,
          "lesson": "models",
          "prerequisites": [
            {
              "all_of": [
                "feature-scaling"
              ]
            }
          ]
        },
        {
          "id": "decision-trees",
          "title": "决策树与随机森林",
          "summary": "按特征阈值分裂，树深与过拟合，随机森林的多数投票，特征重要性",
          "estimated_minutes": 75,
          "lesson": "models",
          "prerequisites": [
            {
              "all_of": [
                "features-labels"
              ]
            }
          ]
        },
        {
          "id": "loss-gradient",
          "title": "损失函数与梯度下降",
          "summary": "损失函数的含义，对数损失，学习率与迭代，梯度下降的直观过程",
          "estimated_minutes": 75,
          "lesson": "models",
          "prerequisites": [
            {
              "all_of": [
                "logistic-regression"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "evaluation",
      "title": "评估与阈值",
      "question_file": "questions/evaluation.json",
      "lessons": [
        {
          "id": "evaluation",
          "title": "评估与阈值",
          "file": "lessons/evaluation.md"
        }
      ],
      "concepts": [
        {
          "id": "confusion-matrix",
          "title": "混淆矩阵",
          "summary": "TP、FP、FN、TN，缺陷为正类时漏检对应 FN、误剔对应 FP，准确率",
          "estimated_minutes": 75,
          "lesson": "evaluation",
          "prerequisites": [
            {
              "all_of": [
                "data-splits"
              ]
            }
          ]
        },
        {
          "id": "precision-recall",
          "title": "精确率、召回率与 F1",
          "summary": "精确率 TP/(TP + FP)，召回率 TP/(TP + FN)，F1，漏检率与误剔率",
          "estimated_minutes": 75,
          "lesson": "evaluation",
          "prerequisites": [
            {
              "all_of": [
                "confusion-matrix"
              ]
            }
          ]
        },
        {
          "id": "thresholds-roc",
          "title": "阈值与 ROC 曲线",
          "summary": "调整概率阈值对漏检和误剔的影响，ROC 曲线与 AUC，精确率–召回率曲线",
          "estimated_minutes": 75,
          "lesson": "evaluation",
          "prerequisites": [
            {
              "all_of": [
                "precision-recall",
                "logistic-regression"
              ]
            }
          ]
        },
        {
          "id": "cost-threshold",
          "title": "按代价选择阈值",
          "summary": "漏检代价与误剔代价，按总代价最小选择阈值，复检区间",
          "estimated_minutes": 65,
          "lesson": "evaluation",
          "prerequisites": [
            {
              "all_of": [
                "thresholds-roc"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "generalization",
      "title": "泛化与调参",
      "question_file": "questions/generalization.json",
      "lessons": [
        {
          "id": "generalization",
          "title": "泛化与调参",
          "file": "lessons/generalization.md"
        }
      ],
      "concepts": [
        {
          "id": "overfitting",
          "title": "过拟合与欠拟合",
          "summary": "训练误差与验证误差，模型复杂度，学习曲线",
          "estimated_minutes": 70,
          "lesson": "generalization",
          "prerequisites": [
            {
              "all_of": [
                "decision-trees"
              ]
            }
          ]
        },
        {
          "id": "cross-validation",
          "title": "交叉验证",
          "summary": "k 折交叉验证，分组交叉验证 GroupKFold，结果的均值与波动",
          "estimated_minutes": 70,
          "lesson": "generalization",
          "prerequisites": [
            {
              "all_of": [
                "overfitting",
                "data-splits"
              ]
            }
          ]
        },
        {
          "id": "hyperparameters",
          "title": "超参数调节",
          "summary": "超参数与参数的区别，网格搜索，只在验证数据上调参，测试集只用一次",
          "estimated_minutes": 65,
          "lesson": "generalization",
          "prerequisites": [
            {
              "all_of": [
                "cross-validation"
              ]
            }
          ]
        },
        {
          "id": "regularization",
          "title": "正则化",
          "summary": "L2 正则化的作用，正则化强度 C 与模型复杂度",
          "estimated_minutes": 55,
          "lesson": "generalization",
          "prerequisites": [
            {
              "all_of": [
                "overfitting",
                "loss-gradient"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "image-models",
      "title": "图像分类与复现",
      "question_file": "questions/image-models.json",
      "lessons": [
        {
          "id": "image-models",
          "title": "图像分类与复现",
          "file": "lessons/image-models.md"
        }
      ],
      "concepts": [
        {
          "id": "image-features",
          "title": "图像特征与卷积网络入门",
          "summary": "手工特征与学习特征，卷积层的直观作用，迁移学习，小数据集的风险",
          "estimated_minutes": 75,
          "lesson": "image-models",
          "prerequisites": [
            {
              "all_of": [
                "features-labels"
              ]
            }
          ]
        },
        {
          "id": "augmentation",
          "title": "数据增强",
          "summary": "旋转、平移、亮度变化等增强，增强只用于训练集，不能改变标签含义",
          "estimated_minutes": 55,
          "lesson": "image-models",
          "prerequisites": [
            {
              "all_of": [
                "image-features"
              ]
            }
          ]
        },
        {
          "id": "pipeline-reproducibility",
          "title": "建模流水线与复现",
          "summary": "scikit-learn Pipeline 把预处理和模型绑定，随机种子，记录数据版本和参数",
          "estimated_minutes": 65,
          "lesson": "image-models",
          "prerequisites": [
            {
              "all_of": [
                "feature-scaling",
                "cross-validation"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "deployment",
      "title": "上线验收",
      "question_file": "questions/deployment.json",
      "lessons": [
        {
          "id": "deployment",
          "title": "上线验收",
          "file": "lessons/deployment.md"
        }
      ],
      "concepts": [
        {
          "id": "latency-throughput",
          "title": "处理耗时与吞吐",
          "summary": "单件处理耗时，节拍与吞吐量，平均值与最坏情况，计时方法",
          "estimated_minutes": 55,
          "lesson": "deployment",
          "prerequisites": [
            {
              "all_of": [
                "rule-baseline"
              ]
            }
          ]
        },
        {
          "id": "independent-validation",
          "title": "独立批次验收",
          "summary": "用未参与训练和调参的新批次验收，与规则法比较，验收标准事先确定",
          "estimated_minutes": 70,
          "lesson": "deployment",
          "prerequisites": [
            {
              "all_of": [
                "precision-recall",
                "data-splits"
              ]
            }
          ]
        },
        {
          "id": "monitoring-drift",
          "title": "数据漂移与监控",
          "summary": "光照、材料、相机变化导致数据漂移，监控指标，复检与重新训练",
          "estimated_minutes": 55,
          "lesson": "deployment",
          "prerequisites": [
            {
              "all_of": [
                "independent-validation"
              ]
            }
          ]
        },
        {
          "id": "batch-validation-lab",
          "title": "规则法与模型对比验收（自评）",
          "summary": "在一批未参与训练的工件上记录真实结果、规则法判定和模型判定，计算两者的漏检率、误剔率和平均处理耗时，写出是否上线的结论。",
          "estimated_minutes": 95,
          "lesson": "deployment",
          "prerequisites": [
            {
              "all_of": [
                "independent-validation",
                "latency-throughput"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
    "palace_planning_instructions": "profiles/palace-planning.txt",
    "palace_research_instructions": "profiles/palace-research.txt"
  },
  "description": "建立缺陷分类基线，用独立批次验证漏检、误剔和延迟。"
}
