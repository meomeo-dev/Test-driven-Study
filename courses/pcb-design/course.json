{
  "protocol_version": 1,
  "course_id": "pcb-design",
  "version": "1.1.0",
  "title": "PCB 设计与调试",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "从面包板到 PCB",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "从面包板到 PCB",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "pcb-workflow",
          "title": "PCB 设计流程",
          "summary": "原理图、封装关联、布局、布线、检查、导出制造文件的流程，各步的产物",
          "estimated_minutes": 65,
          "lesson": "intro"
        },
        {
          "id": "pcb-structure",
          "title": "PCB 结构与层",
          "summary": "FR-4 基材、铜层、阻焊、丝印、焊盘与过孔，双层板，铜厚 1 oz ≈ 35 µm",
          "estimated_minutes": 70,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "pcb-workflow"
              ]
            }
          ]
        },
        {
          "id": "breadboard-review",
          "title": "面包板电路复核",
          "summary": "画板前核对电路功能、电源电压、电流、接口方向和测量记录",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "pcb-workflow"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "schematic",
      "title": "原理图",
      "question_file": "questions/schematic.json",
      "lessons": [
        {
          "id": "schematic",
          "title": "原理图",
          "file": "lessons/schematic.md"
        }
      ],
      "concepts": [
        {
          "id": "symbols-nets",
          "title": "符号、网络与网络标签",
          "summary": "符号与引脚，导线与网络，网络标签同名即连接，全局标签与层次",
          "estimated_minutes": 80,
          "lesson": "schematic",
          "prerequisites": [
            {
              "all_of": [
                "pcb-workflow"
              ]
            }
          ]
        },
        {
          "id": "power-symbols",
          "title": "电源符号与接地",
          "summary": "电源符号是全局网络，GND 与 +5V 等，电源标志 PWR_FLAG 的作用",
          "estimated_minutes": 65,
          "lesson": "schematic",
          "prerequisites": [
            {
              "all_of": [
                "symbols-nets"
              ]
            }
          ]
        },
        {
          "id": "erc",
          "title": "电气规则检查 ERC",
          "summary": "引脚电气类型，未连接引脚，输入未驱动，电源未驱动，ERC 无法发现的错误",
          "estimated_minutes": 70,
          "lesson": "schematic",
          "prerequisites": [
            {
              "all_of": [
                "symbols-nets",
                "power-symbols"
              ]
            }
          ]
        },
        {
          "id": "bom-annotation",
          "title": "位号、元件值与 BOM",
          "summary": "R1、C1、U1、J1 等位号，元件值与型号，BOM 汇总数量",
          "estimated_minutes": 55,
          "lesson": "schematic",
          "prerequisites": [
            {
              "all_of": [
                "symbols-nets"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "footprints",
      "title": "封装与器件资料",
      "question_file": "questions/footprints.json",
      "lessons": [
        {
          "id": "footprints",
          "title": "封装与器件资料",
          "file": "lessons/footprints.md"
        }
      ],
      "concepts": [
        {
          "id": "footprints",
          "title": "封装与焊盘",
          "summary": "通孔 THT 与贴片 SMD，0805、SOT-23、2.54 mm 排针，焊盘与丝印外框",
          "estimated_minutes": 80,
          "lesson": "footprints",
          "prerequisites": [
            {
              "all_of": [
                "symbols-nets"
              ]
            }
          ]
        },
        {
          "id": "datasheet-pinout",
          "title": "按手册核对引脚",
          "summary": "引脚 1 标识，俯视图与仰视图，连接器脚序与线缆方向，符号引脚号与封装焊盘号一致",
          "estimated_minutes": 80,
          "lesson": "footprints",
          "prerequisites": [
            {
              "all_of": [
                "footprints"
              ]
            }
          ]
        },
        {
          "id": "footprint-assignment",
          "title": "符号与封装关联",
          "summary": "为每个符号指定封装，同一器件不同封装，三维模型检查",
          "estimated_minutes": 65,
          "lesson": "footprints",
          "prerequisites": [
            {
              "all_of": [
                "footprints"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "layout",
      "title": "布局",
      "question_file": "questions/layout.json",
      "lessons": [
        {
          "id": "layout",
          "title": "布局",
          "file": "lessons/layout.md"
        }
      ],
      "concepts": [
        {
          "id": "board-outline",
          "title": "板框与安装孔",
          "summary": "Edge.Cuts 板框，安装孔直径与位置，孔到板边距离，禁止布线区",
          "estimated_minutes": 70,
          "lesson": "layout",
          "prerequisites": [
            {
              "all_of": [
                "pcb-structure"
              ]
            }
          ]
        },
        {
          "id": "placement",
          "title": "元件布局原则",
          "summary": "连接器靠板边，按信号流布局，去耦电容靠近芯片电源脚，测试点",
          "estimated_minutes": 80,
          "lesson": "layout",
          "prerequisites": [
            {
              "all_of": [
                "board-outline",
                "footprint-assignment"
              ]
            }
          ]
        },
        {
          "id": "grounding",
          "title": "接地与电源分配",
          "summary": "地平面与铺铜，电流回流路径，大电流负载与信号地的分开走线",
          "estimated_minutes": 80,
          "lesson": "layout",
          "prerequisites": [
            {
              "all_of": [
                "placement"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "routing",
      "title": "布线",
      "question_file": "questions/routing.json",
      "lessons": [
        {
          "id": "routing",
          "title": "布线",
          "file": "lessons/routing.md"
        }
      ],
      "concepts": [
        {
          "id": "trace-width",
          "title": "线宽与电流",
          "summary": "电流越大线宽越宽，铜厚与温升，走线电阻 R = ρL/(w·t) 与压降",
          "estimated_minutes": 85,
          "lesson": "routing",
          "prerequisites": [
            {
              "all_of": [
                "pcb-structure"
              ]
            }
          ]
        },
        {
          "id": "clearance-rules",
          "title": "间距与设计规则",
          "summary": "线距、焊盘间距、最小孔径与孔环，按制板厂工艺设置规则",
          "estimated_minutes": 70,
          "lesson": "routing",
          "prerequisites": [
            {
              "all_of": [
                "trace-width"
              ]
            }
          ]
        },
        {
          "id": "routing-practice",
          "title": "布线方法",
          "summary": "先布电源和关键信号，走线短而直，45° 拐角，过孔换层",
          "estimated_minutes": 80,
          "lesson": "routing",
          "prerequisites": [
            {
              "all_of": [
                "grounding",
                "clearance-rules"
              ]
            }
          ]
        },
        {
          "id": "drc",
          "title": "设计规则检查 DRC",
          "summary": "间距违规、未连接网络、板框外元件，DRC 通过不等于功能正确",
          "estimated_minutes": 70,
          "lesson": "routing",
          "prerequisites": [
            {
              "all_of": [
                "clearance-rules"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "integrity",
      "title": "噪声与接口保护",
      "question_file": "questions/integrity.json",
      "lessons": [
        {
          "id": "integrity",
          "title": "噪声与接口保护",
          "file": "lessons/integrity.md"
        }
      ],
      "concepts": [
        {
          "id": "decoupling",
          "title": "去耦电容",
          "summary": "100 nF 去耦电容靠近电源脚，大容量电解电容储能，电流回路面积",
          "estimated_minutes": 70,
          "lesson": "integrity",
          "prerequisites": [
            {
              "all_of": [
                "grounding"
              ]
            }
          ]
        },
        {
          "id": "emc-basics",
          "title": "噪声与 EMC 基础",
          "summary": "开关负载引起的噪声，长导线天线效应，地回路，电机线与信号线分开",
          "estimated_minutes": 65,
          "lesson": "integrity",
          "prerequisites": [
            {
              "all_of": [
                "decoupling"
              ]
            }
          ]
        },
        {
          "id": "interface-protection",
          "title": "接口保护",
          "summary": "电源反接保护二极管，TVS 管，信号串联限流电阻，连接器防插反",
          "estimated_minutes": 65,
          "lesson": "integrity",
          "prerequisites": [
            {
              "all_of": [
                "datasheet-pinout"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "fabrication",
      "title": "制造与调试",
      "question_file": "questions/fabrication.json",
      "lessons": [
        {
          "id": "fabrication",
          "title": "制造与调试",
          "file": "lessons/fabrication.md"
        }
      ],
      "concepts": [
        {
          "id": "gerber-drill",
          "title": "Gerber 与钻孔文件",
          "summary": "各层 Gerber 与钻孔文件，导出后用查看器检查，文件打包",
          "estimated_minutes": 65,
          "lesson": "fabrication",
          "prerequisites": [
            {
              "all_of": [
                "drc"
              ]
            }
          ]
        },
        {
          "id": "fab-constraints",
          "title": "制板工艺与成本",
          "summary": "板厚、层数、最小线宽线距、表面处理，尺寸与数量对成本的影响",
          "estimated_minutes": 55,
          "lesson": "fabrication",
          "prerequisites": [
            {
              "all_of": [
                "gerber-drill"
              ]
            }
          ]
        },
        {
          "id": "assembly-soldering",
          "title": "焊接与装配",
          "summary": "焊接顺序从矮到高，手工焊接温度，检查桥连与虚焊",
          "estimated_minutes": 65,
          "lesson": "fabrication",
          "prerequisites": [
            {
              "all_of": [
                "footprints"
              ]
            }
          ]
        },
        {
          "id": "board-bring-up",
          "title": "首板上电与调试",
          "summary": "上电前测电源与地之间的电阻，限流电源上电，逐级测量电压，记录问题",
          "estimated_minutes": 80,
          "lesson": "fabrication",
          "prerequisites": [
            {
              "all_of": [
                "assembly-soldering"
              ]
            }
          ]
        },
        {
          "id": "interface-board-lab",
          "title": "传感器接口板设计（自评）",
          "summary": "在 KiCad 中完成传感器接口板的原理图和 PCB，通过 ERC 和 DRC，按器件手册逐脚核对连接器脚序，检查板框尺寸和安装孔位置。",
          "estimated_minutes": 105,
          "lesson": "fabrication",
          "prerequisites": [
            {
              "all_of": [
                "erc",
                "drc",
                "datasheet-pinout"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
    "palace_planning_instructions": "profiles/palace-planning.txt",
    "palace_research_instructions": "profiles/palace-research.txt"
  },
  "description": "将已验证的低压传感器接口从原理图做成可装配的电路板。",
  "roadmap": {
    "note": "选修。建议先完成电路基础与单片机样机，并确认器件和接线方案。",
    "prerequisites": [
      {
        "all_of": [
          "circuit-fundamentals",
          "embedded-mcu"
        ],
        "strength": "recommended"
      }
    ]
  }
}
