{
  "protocol_version": 1,
  "course_id": "linear-algebra",
  "version": "1.1.0",
  "title": "线性代数",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "向量与坐标",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "向量与坐标",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "vectors-components",
          "title": "向量与分量",
          "summary": "有向线段，二维与三维分量，位移向量 = 终点坐标 − 起点坐标，零向量",
          "estimated_minutes": 60,
          "lesson": "intro"
        },
        {
          "id": "vector-arithmetic",
          "title": "向量加减与数乘",
          "summary": "按分量相加减，数乘改变长度和方向，平行四边形法则",
          "estimated_minutes": 60,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "vectors-components"
              ]
            }
          ]
        },
        {
          "id": "norm-distance",
          "title": "向量长度与距离",
          "summary": "‖v‖ = √(x² + y²)，三维长度，两点距离，单位向量 v/‖v‖",
          "estimated_minutes": 55,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "vector-arithmetic"
              ]
            }
          ]
        },
        {
          "id": "dot-product",
          "title": "点积与夹角",
          "summary": "a·b = a₁b₁ + a₂b₂，a·b = ‖a‖‖b‖cosθ，正交判断，投影长度 a·b/‖b‖",
          "estimated_minutes": 75,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "norm-distance"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "combinations",
      "title": "线性组合与基",
      "question_file": "questions/combinations.json",
      "lessons": [
        {
          "id": "combinations",
          "title": "线性组合与基",
          "file": "lessons/combinations.md"
        }
      ],
      "concepts": [
        {
          "id": "linear-combination",
          "title": "线性组合",
          "summary": "c₁v₁ + c₂v₂，求组合系数，用两个方向向量表示平面内的位移",
          "estimated_minutes": 65,
          "lesson": "combinations",
          "prerequisites": [
            {
              "all_of": [
                "vector-arithmetic"
              ]
            }
          ]
        },
        {
          "id": "span-independence",
          "title": "张成与线性无关",
          "summary": "张成的直线或平面，线性相关与无关的判断，二维中两个向量共线即相关",
          "estimated_minutes": 80,
          "lesson": "combinations",
          "prerequisites": [
            {
              "all_of": [
                "linear-combination"
              ]
            }
          ]
        },
        {
          "id": "basis-coordinates",
          "title": "基与坐标表示",
          "summary": "标准基 e₁、e₂，基的条件，同一向量在另一组基下的坐标",
          "estimated_minutes": 75,
          "lesson": "combinations",
          "prerequisites": [
            {
              "all_of": [
                "span-independence"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "matrices",
      "title": "矩阵运算",
      "question_file": "questions/matrices.json",
      "lessons": [
        {
          "id": "matrices",
          "title": "矩阵运算",
          "file": "lessons/matrices.md"
        }
      ],
      "concepts": [
        {
          "id": "matrix-basics",
          "title": "矩阵与记号",
          "summary": "m×n 矩阵，元素 aᵢⱼ，方阵、单位矩阵、零矩阵，矩阵加法与数乘，转置",
          "estimated_minutes": 50,
          "lesson": "matrices",
          "prerequisites": [
            {
              "all_of": [
                "vectors-components"
              ]
            }
          ]
        },
        {
          "id": "matrix-vector",
          "title": "矩阵乘向量",
          "summary": "Ax 的计算，按列看 Ax 是各列的线性组合，维度匹配",
          "estimated_minutes": 70,
          "lesson": "matrices",
          "prerequisites": [
            {
              "all_of": [
                "matrix-basics",
                "linear-combination"
              ]
            }
          ]
        },
        {
          "id": "matrix-multiply",
          "title": "矩阵乘法",
          "summary": "AB 的计算与维度要求，一般 AB ≠ BA，结合律，单位矩阵 I",
          "estimated_minutes": 80,
          "lesson": "matrices",
          "prerequisites": [
            {
              "all_of": [
                "matrix-vector"
              ]
            }
          ]
        },
        {
          "id": "transpose-symmetric",
          "title": "转置与对称矩阵",
          "summary": "(AB)ᵀ = BᵀAᵀ，对称矩阵 Aᵀ = A，AᵀA 是对称矩阵",
          "estimated_minutes": 50,
          "lesson": "matrices",
          "prerequisites": [
            {
              "all_of": [
                "matrix-multiply"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "systems",
      "title": "线性方程组",
      "question_file": "questions/systems.json",
      "lessons": [
        {
          "id": "systems",
          "title": "线性方程组",
          "file": "lessons/systems.md"
        }
      ],
      "concepts": [
        {
          "id": "systems-matrix-form",
          "title": "方程组与矩阵形式",
          "summary": "把线性方程组写成 Ax = b，系数矩阵与增广矩阵",
          "estimated_minutes": 55,
          "lesson": "systems",
          "prerequisites": [
            {
              "all_of": [
                "matrix-vector"
              ]
            }
          ]
        },
        {
          "id": "gaussian-elimination",
          "title": "高斯消元",
          "summary": "三种初等行变换，化为阶梯形，回代求解 2–3 个未知数",
          "estimated_minutes": 85,
          "lesson": "systems",
          "prerequisites": [
            {
              "all_of": [
                "systems-matrix-form"
              ]
            }
          ]
        },
        {
          "id": "solution-types",
          "title": "解的情况与秩",
          "summary": "唯一解、无解、无穷多解，矩阵的秩，秩与解的关系",
          "estimated_minutes": 75,
          "lesson": "systems",
          "prerequisites": [
            {
              "all_of": [
                "gaussian-elimination",
                "span-independence"
              ]
            }
          ]
        },
        {
          "id": "inverse-matrix",
          "title": "逆矩阵",
          "summary": "AA⁻¹ = I，2×2 逆矩阵公式，可逆条件，用 x = A⁻¹b 求解",
          "estimated_minutes": 75,
          "lesson": "systems",
          "prerequisites": [
            {
              "all_of": [
                "gaussian-elimination",
                "matrix-multiply"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "determinants",
      "title": "行列式",
      "question_file": "questions/determinants.json",
      "lessons": [
        {
          "id": "determinants",
          "title": "行列式",
          "file": "lessons/determinants.md"
        }
      ],
      "concepts": [
        {
          "id": "determinant-computation",
          "title": "二阶与三阶行列式",
          "summary": "ad − bc，三阶行列式按第一行展开",
          "estimated_minutes": 65,
          "lesson": "determinants",
          "prerequisites": [
            {
              "all_of": [
                "matrix-basics"
              ]
            }
          ]
        },
        {
          "id": "determinant-geometry",
          "title": "行列式的几何意义",
          "summary": "面积与体积的缩放倍数，负号表示翻转，行列式为 0 表示压扁降维",
          "estimated_minutes": 60,
          "lesson": "determinants",
          "prerequisites": [
            {
              "all_of": [
                "determinant-computation"
              ]
            }
          ]
        },
        {
          "id": "determinant-properties",
          "title": "行列式性质与可逆性",
          "summary": "det(AB) = det A · det B，交换两行变号，det A ≠ 0 当且仅当可逆",
          "estimated_minutes": 60,
          "lesson": "determinants",
          "prerequisites": [
            {
              "all_of": [
                "determinant-geometry",
                "inverse-matrix"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "transforms",
      "title": "线性变换与坐标变换",
      "question_file": "questions/transforms.json",
      "lessons": [
        {
          "id": "transforms",
          "title": "线性变换与坐标变换",
          "file": "lessons/transforms.md"
        }
      ],
      "concepts": [
        {
          "id": "linear-transform",
          "title": "线性变换",
          "summary": "线性变换的两个条件，由基向量的像写出变换矩阵，平移不是线性变换",
          "estimated_minutes": 70,
          "lesson": "transforms",
          "prerequisites": [
            {
              "all_of": [
                "matrix-vector"
              ]
            }
          ]
        },
        {
          "id": "rotation-scaling",
          "title": "旋转、缩放与剪切",
          "summary": "二维旋转矩阵 [[cosθ, −sinθ], [sinθ, cosθ]]，缩放、剪切、镜像，组合变换的顺序",
          "estimated_minutes": 80,
          "lesson": "transforms",
          "prerequisites": [
            {
              "all_of": [
                "linear-transform",
                "dot-product"
              ]
            }
          ]
        },
        {
          "id": "homogeneous-coordinates",
          "title": "齐次坐标与平移",
          "summary": "二维点写成 (x, y, 1)，3×3 矩阵同时表示旋转和平移，刚体变换",
          "estimated_minutes": 75,
          "lesson": "transforms",
          "prerequisites": [
            {
              "all_of": [
                "rotation-scaling",
                "matrix-multiply"
              ]
            }
          ]
        },
        {
          "id": "change-of-frame",
          "title": "坐标系变换",
          "summary": "同一点在夹具坐标系和相机坐标系中的坐标，变换的方向与逆变换",
          "estimated_minutes": 80,
          "lesson": "transforms",
          "prerequisites": [
            {
              "all_of": [
                "homogeneous-coordinates",
                "basis-coordinates"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "applications",
      "title": "特征值与工程应用",
      "question_file": "questions/applications.json",
      "lessons": [
        {
          "id": "applications",
          "title": "特征值与工程应用",
          "file": "lessons/applications.md"
        }
      ],
      "concepts": [
        {
          "id": "eigen-basics",
          "title": "特征值与特征向量入门",
          "summary": "Av = λv，2×2 特征多项式 det(A − λI) = 0，对角矩阵与缩放方向",
          "estimated_minutes": 80,
          "lesson": "applications",
          "prerequisites": [
            {
              "all_of": [
                "determinant-properties",
                "linear-transform"
              ]
            }
          ]
        },
        {
          "id": "least-squares",
          "title": "最小二乘拟合",
          "summary": "超定方程组，正规方程 AᵀAx = Aᵀb，用测量点拟合直线",
          "estimated_minutes": 85,
          "lesson": "applications",
          "prerequisites": [
            {
              "all_of": [
                "solution-types",
                "transpose-symmetric"
              ]
            }
          ]
        },
        {
          "id": "calibration-constraints",
          "title": "标定约束方程",
          "summary": "由对应点建立比例与平移的线性方程，用多组点估计像素与毫米的换算",
          "estimated_minutes": 70,
          "lesson": "applications",
          "prerequisites": [
            {
              "all_of": [
                "least-squares",
                "homogeneous-coordinates"
              ]
            }
          ]
        },
        {
          "id": "rotation-lab",
          "title": "夹具点旋转验证（自评）",
          "summary": "把夹具上三个二维点绕原点逆时针旋转 90°，写出旋转矩阵，手算并用画图核对结果。",
          "estimated_minutes": 65,
          "lesson": "applications",
          "prerequisites": [
            {
              "all_of": [
                "rotation-scaling"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
    "palace_planning_instructions": "profiles/palace-planning.txt",
    "palace_research_instructions": "profiles/palace-research.txt"
  },
  "description": "用向量、矩阵和线性变换理解夹具坐标与相机坐标。"
}
