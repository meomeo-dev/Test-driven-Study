{
  "protocol_version": 1,
  "course_id": "machine-vision",
  "version": "1.1.0",
  "title": "机器视觉与图像处理",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "数字图像基础",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "数字图像基础",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "pixels-images",
          "title": "像素、分辨率与坐标",
          "summary": "像素与分辨率，宽和高，图像坐标 x 向右、y 向下，像素总数",
          "estimated_minutes": 65,
          "lesson": "intro"
        },
        {
          "id": "color-gray",
          "title": "颜色通道与灰度",
          "summary": "RGB 与 OpenCV 的 BGR 顺序，8 位 0–255 灰度，彩色转灰度",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "pixels-images"
              ]
            }
          ]
        },
        {
          "id": "images-as-arrays",
          "title": "图像即数组",
          "summary": "NumPy 数组 shape (h, w, c)，img[y, x] 的索引顺序，切片取 ROI，uint8 运算溢出",
          "estimated_minutes": 85,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "pixels-images"
              ]
            }
          ]
        },
        {
          "id": "read-write-images",
          "title": "读写图像",
          "summary": "cv2.imread 失败时返回 None，灰度读取，cv2.imwrite，路径与文件格式",
          "estimated_minutes": 50,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "images-as-arrays"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "acquisition",
      "title": "成像与采集",
      "question_file": "questions/acquisition.json",
      "lessons": [
        {
          "id": "acquisition",
          "title": "成像与采集",
          "file": "lessons/acquisition.md"
        }
      ],
      "concepts": [
        {
          "id": "camera-basics",
          "title": "相机、镜头与视场",
          "summary": "传感器分辨率、焦距、工作距离与视场，像素当量 = 视场宽度/像素数",
          "estimated_minutes": 70,
          "lesson": "acquisition",
          "prerequisites": [
            {
              "all_of": [
                "pixels-images"
              ]
            }
          ]
        },
        {
          "id": "lighting",
          "title": "光照方式",
          "summary": "背光、环形光、同轴光、漫射光的效果，反光与阴影",
          "estimated_minutes": 70,
          "lesson": "acquisition",
          "prerequisites": [
            {
              "all_of": [
                "camera-basics"
              ]
            }
          ]
        },
        {
          "id": "exposure-focus",
          "title": "曝光、增益与对焦",
          "summary": "曝光时间、增益与噪声，过曝与欠曝，景深与对焦",
          "estimated_minutes": 65,
          "lesson": "acquisition",
          "prerequisites": [
            {
              "all_of": [
                "camera-basics"
              ]
            }
          ]
        },
        {
          "id": "fixed-setup",
          "title": "固定相机与采集规范",
          "summary": "固定相机位置和背景，锁定曝光和白平衡，样本命名与标签记录",
          "estimated_minutes": 60,
          "lesson": "acquisition",
          "prerequisites": [
            {
              "all_of": [
                "lighting",
                "exposure-focus"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "preprocessing",
      "title": "图像预处理",
      "question_file": "questions/preprocessing.json",
      "lessons": [
        {
          "id": "preprocessing",
          "title": "图像预处理",
          "file": "lessons/preprocessing.md"
        }
      ],
      "concepts": [
        {
          "id": "histograms-contrast",
          "title": "直方图与对比度",
          "summary": "灰度直方图，亮度与对比度调整，直方图均衡化",
          "estimated_minutes": 70,
          "lesson": "preprocessing",
          "prerequisites": [
            {
              "all_of": [
                "color-gray"
              ]
            }
          ]
        },
        {
          "id": "filtering",
          "title": "平滑滤波与去噪",
          "summary": "均值滤波、高斯滤波、中值滤波，核大小为奇数，椒盐噪声用中值滤波",
          "estimated_minutes": 70,
          "lesson": "preprocessing",
          "prerequisites": [
            {
              "all_of": [
                "images-as-arrays"
              ]
            }
          ]
        },
        {
          "id": "geometric-transforms",
          "title": "缩放、旋转与裁剪",
          "summary": "cv2.resize 与插值，旋转矩阵 cv2.getRotationMatrix2D，裁剪 ROI 后坐标的换算",
          "estimated_minutes": 60,
          "lesson": "preprocessing",
          "prerequisites": [
            {
              "all_of": [
                "images-as-arrays"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "segmentation",
      "title": "阈值分割与轮廓",
      "question_file": "questions/segmentation.json",
      "lessons": [
        {
          "id": "segmentation",
          "title": "阈值分割与轮廓",
          "file": "lessons/segmentation.md"
        }
      ],
      "concepts": [
        {
          "id": "thresholding",
          "title": "全局阈值与 Otsu",
          "summary": "二值化 cv2.threshold，THRESH_BINARY 与 THRESH_BINARY_INV，Otsu 自动阈值",
          "estimated_minutes": 80,
          "lesson": "segmentation",
          "prerequisites": [
            {
              "all_of": [
                "histograms-contrast"
              ]
            }
          ]
        },
        {
          "id": "adaptive-threshold",
          "title": "自适应阈值与光照不均",
          "summary": "光照不均时全局阈值失效，cv2.adaptiveThreshold 的块大小与常数",
          "estimated_minutes": 65,
          "lesson": "segmentation",
          "prerequisites": [
            {
              "all_of": [
                "thresholding"
              ]
            }
          ]
        },
        {
          "id": "morphology",
          "title": "形态学操作",
          "summary": "腐蚀、膨胀、开运算去小噪点、闭运算填小孔，结构元素大小",
          "estimated_minutes": 70,
          "lesson": "segmentation",
          "prerequisites": [
            {
              "all_of": [
                "thresholding"
              ]
            }
          ]
        },
        {
          "id": "contours",
          "title": "轮廓提取与层级",
          "summary": "cv2.findContours，外轮廓与内轮廓，RETR_EXTERNAL 与 RETR_CCOMP，孔是内轮廓",
          "estimated_minutes": 80,
          "lesson": "segmentation",
          "prerequisites": [
            {
              "all_of": [
                "morphology"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "features",
      "title": "形状特征与孔检测",
      "question_file": "questions/features.json",
      "lessons": [
        {
          "id": "features",
          "title": "形状特征与孔检测",
          "file": "lessons/features.md"
        }
      ],
      "concepts": [
        {
          "id": "contour-features",
          "title": "面积、周长与外接框",
          "summary": "cv2.contourArea、cv2.arcLength、cv2.boundingRect、最小外接圆与质心",
          "estimated_minutes": 70,
          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "contours"
              ]
            }
          ]
        },
        {
          "id": "shape-descriptors",
          "title": "圆度与形状描述",
          "summary": "圆度 = 4π·面积/周长²，长宽比，按面积和圆度筛选轮廓",
          "estimated_minutes": 65,
          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "contour-features"
              ]
            }
          ]
        },
        {
          "id": "edges",
          "title": "边缘检测",
          "summary": "梯度与 Sobel，Canny 的两个阈值，边缘与阈值分割的区别",
          "estimated_minutes": 65,
          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "filtering"
              ]
            }
          ]
        },
        {
          "id": "hole-detection",
          "title": "孔位检测与缺孔判定",
          "summary": "在工件区域内找孔，按面积范围计数，期望孔数与缺孔判定",
          "estimated_minutes": 80,
          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "contour-features",
                "shape-descriptors"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "calibration",
      "title": "标定与尺寸测量",
      "question_file": "questions/calibration.json",
      "lessons": [
        {
          "id": "calibration",
          "title": "标定与尺寸测量",
          "file": "lessons/calibration.md"
        }
      ],
      "concepts": [
        {
          "id": "pixel-mm-scale",
          "title": "像素与毫米换算",
          "summary": "用同一平面上的已知尺寸参考件求比例，比例只适用于同一高度和位置",
          "estimated_minutes": 70,
          "lesson": "calibration",
          "prerequisites": [
            {
              "all_of": [
                "camera-basics",
                "contour-features"
              ]
            }
          ]
        },
        {
          "id": "lens-distortion",
          "title": "镜头畸变与相机标定",
          "summary": "桶形与枕形畸变，棋盘格标定的作用，内参与畸变系数的概念",
          "estimated_minutes": 70,
          "lesson": "calibration",
          "prerequisites": [
            {
              "all_of": [
                "pixel-mm-scale"
              ]
            }
          ]
        },
        {
          "id": "measurement-accuracy",
          "title": "测量误差与验证",
          "summary": "亚像素与边缘位置误差，用卡尺对照验证，重复拍摄的波动",
          "estimated_minutes": 65,
          "lesson": "calibration",
          "prerequisites": [
            {
              "all_of": [
                "pixel-mm-scale"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inspection",
      "title": "检测流程与评估",
      "question_file": "questions/inspection.json",
      "lessons": [
        {
          "id": "inspection",
          "title": "检测流程与评估",
          "file": "lessons/inspection.md"
        }
      ],
      "concepts": [
        {
          "id": "inspection-pipeline",
          "title": "检测流程与 ROI",
          "summary": "采集、预处理、分割、特征、判定、记录的流程，固定 ROI，参数写入配置",
          "estimated_minutes": 65,
          "lesson": "inspection",
          "prerequisites": [
            {
              "all_of": [
                "hole-detection"
              ]
            }
          ]
        },
        {
          "id": "robustness",
          "title": "鲁棒性与失效分析",
          "summary": "光照变化、位置偏移、脏污对阈值法的影响，记录失效条件",
          "estimated_minutes": 65,
          "lesson": "inspection",
          "prerequisites": [
            {
              "all_of": [
                "inspection-pipeline",
                "lighting"
              ]
            }
          ]
        },
        {
          "id": "detection-metrics",
          "title": "检测结果的评估",
          "summary": "漏检与误判计数，混淆表，用带标签的独立样本评估",
          "estimated_minutes": 65,
          "lesson": "inspection",
          "prerequisites": [
            {
              "all_of": [
                "inspection-pipeline"
              ]
            }
          ]
        },
        {
          "id": "hole-inspection-lab",
          "title": "有孔与缺孔检测实验（自评）",
          "summary": "固定相机和光照，拍摄有孔与缺孔垫片各若干张，用阈值和轮廓找孔并判定；再改变一次光照，记录失效的条件和原因。",
          "estimated_minutes": 95,
          "lesson": "inspection",
          "prerequisites": [
            {
              "all_of": [
                "hole-detection",
                "robustness"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
