        {
          "id": "past-regular",
          "title": "规则动词过去式",
          "summary": "-ed 拼写规则（checked、stopped、tried、moved）与读音 /t/ /d/ /ɪd/，yesterday、last night、this morning",
          "estimated_minutes": 60,
          "lesson": "past-reports",
          "prerequisites": [
            {
              "all_of": [
                "workbench-actions"
              ]
            }
          ]
        },
        {
          "id": "past-irregular",
          "title": "常用不规则动词过去式",
          "summary": "go-went、come-came、have-had、make-made、take-took、put-put、find-found、see-saw、get-got、break-broke、give-gave、tell-told",
          "estimated_minutes": 75,
          "lesson": "past-reports",
          "prerequisites": [
            {
              "all_of": [
                "past-regular"
              ]
            }
          ]
        },
        {
          "id": "did-questions",
          "title": "过去时疑问与否定 did",
          "summary": "Did you check the parts? Yes, I did.，I didn't see the error.，did / didn't 后接动词原形",
          "estimated_minutes": 55,
          "lesson": "past-reports",
          "prerequisites": [
            {
              "all_of": [
                "past-regular",
                "yes-no-questions"
              ]
            }
          ]
        },
        {
          "id": "oral-shift-report",
          "title": "口头交接班汇报（自评）",
          "summary": "用过去时口头汇报一个班次的产量、问题和处理结果，录音后自评。",
          "estimated_minutes": 60,
          "lesson": "past-reports",
          "prerequisites": [
            {
              "all_of": [
                "past-irregular",
                "did-questions",
                "reporting-problems"
              ]
            }
          ]
        }
      ]
