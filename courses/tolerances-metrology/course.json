      "question_file": "questions/fits.json",
      "lessons": [
        {
          "id": "fits",
          "title": "孔轴配合",
          "file": "lessons/fits.md"
        }
      ],
      "concepts": [
        {
          "id": "hole-shaft-basics",
          "title": "孔、轴与基孔制",
