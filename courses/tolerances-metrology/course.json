{
  "protocol_version": 1,
  "course_id": "tolerances-metrology",
  "version": "1.1.0",
  "title": "公差配合与测量",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "尺寸与公差",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "尺寸与公差",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "nominal-dimensions",
          "title": "名义尺寸与尺寸标注",
          "summary": "名义尺寸，线性尺寸、直径 ⌀、半径 R 的标注，基准边与尺寸起点",
          "estimated_minutes": 65,
          "lesson": "intro"
        },
        {
          "id": "limits-deviations",
          "title": "极限尺寸与极限偏差",
          "summary": "上极限尺寸与下极限尺寸，上偏差 ES/es 与下偏差 EI/ei，实际尺寸是否在范围内",
          "estimated_minutes": 80,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "nominal-dimensions"
              ]
            }
          ]
        },
        {
          "id": "tolerance-notation",
          "title": "公差标注与公差带",
          "summary": "对称公差 ±、单向公差、极限尺寸标注，公差 = 上极限尺寸 − 下极限尺寸",
          "estimated_minutes": 70,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "limits-deviations"
              ]
            }
          ]
        },
        {
          "id": "general-tolerances",
          "title": "一般公差",
          "summary": "未注公差尺寸按一般公差等级执行，精密、中等、粗糙等级的含义",
          "estimated_minutes": 50,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "tolerance-notation"
              ]
            }
          ]
        }
      ]
    },
    {
