{
  "protocol_version": 1,
  "course_id": "embedded-mcu",
  "version": "1.1.0",
  "title": "单片机与嵌入式开发",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "单片机与开发环境",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "单片机与开发环境",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "mcu-architecture",
          "title": "单片机的组成",
          "summary": "CPU、Flash、RAM、GPIO 与外设，时钟，和电脑的区别",
          "estimated_minutes": 55,
          "lesson": "intro"
        },
        {
          "id": "toolchain-upload",
          "title": "开发环境、编译与下载",
          "summary": "IDE 或 ESP-IDF，编译、烧录、串口监视器，模拟器",
          "estimated_minutes": 50,
          "lesson": "intro"
        },
        {
          "id": "superloop",
          "title": "程序结构 setup 与 loop",
          "summary": "初始化一次、循环反复执行的超级循环结构",
          "estimated_minutes": 55,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "toolchain-upload"
              ]
            }
          ]
        },
        {
          "id": "logic-levels",
          "title": "逻辑电平与引脚电气限制",
          "summary": "3.3 V 与 5 V 逻辑，高低电平阈值，引脚最大电流，不能超压输入",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "mcu-architecture"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "gpio",
      "title": "GPIO 输入与输出",
      "question_file": "questions/gpio.json",
      "lessons": [
        {
          "id": "gpio",
          "title": "GPIO 输入与输出",
          "file": "lessons/gpio.md"
        }
      ],
      "concepts": [
        {
          "id": "gpio-output",
          "title": "数字输出驱动 LED",
          "summary": "pinMode 输出，高低电平，LED 限流电阻，引脚拉电流与灌电流",
          "estimated_minutes": 55,
          "lesson": "gpio",
          "prerequisites": [
            {
              "all_of": [
                "superloop",
                "logic-levels"
              ]
            }
          ]
        },
        {
          "id": "gpio-input",
          "title": "数字输入与上拉、下拉",
          "summary": "输入模式，内部上拉，按下为低的接法，悬空输入",
          "estimated_minutes": 60,
          "lesson": "gpio",
          "prerequisites": [
            {
              "all_of": [
                "gpio-output"
              ]
            }
          ]
        },
        {
          "id": "debounce",
          "title": "按键消抖",
          "summary": "机械抖动 5–20 ms，延时确认或连续采样确认的软件消抖",
          "estimated_minutes": 75,
          "lesson": "gpio",
          "prerequisites": [
            {
              "all_of": [
                "gpio-input"
              ]
            }
          ]
        },
        {
          "id": "edge-events",
          "title": "边沿检测与事件计数",
          "summary": "比较本次与上次状态得到上升沿、下降沿，稳态与事件的区别，只计一次",
          "estimated_minutes": 65,
          "lesson": "gpio",
          "prerequisites": [
            {
              "all_of": [
                "debounce"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "timing",
      "title": "计时、中断与 PWM",
      "question_file": "questions/timing.json",
      "lessons": [
        {
          "id": "timing",
          "title": "计时、中断与 PWM",
          "file": "lessons/timing.md"
        }
      ],
      "concepts": [
        {
          "id": "nonblocking-timing",
          "title": "阻塞延时与非阻塞计时",
          "summary": "delay 阻塞的问题，millis 当前时间减开始时间判断超时，无符号回绕",
          "estimated_minutes": 75,
          "lesson": "timing",
          "prerequisites": [
            {
              "all_of": [
                "superloop"
              ]
            }
          ]
        },
        {
          "id": "interrupts",
          "title": "外部中断与 volatile",
          "summary": "中断服务函数要短，volatile 共享变量，中断与轮询的取舍",
          "estimated_minutes": 80,
          "lesson": "timing",
          "prerequisites": [
            {
              "all_of": [
                "edge-events"
              ]
            }
          ]
        },
        {
          "id": "timers-pwm",
          "title": "定时器与 PWM",
          "summary": "PWM 周期、频率与占空比，平均电压，定时器产生 PWM",
          "estimated_minutes": 75,
          "lesson": "timing",
          "prerequisites": [
            {
              "all_of": [
                "nonblocking-timing"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "serial",
      "title": "串口通信与调试",
      "question_file": "questions/serial.json",
      "lessons": [
        {
          "id": "serial",
          "title": "串口通信与调试",
          "file": "lessons/serial.md"
        }
      ],
      "concepts": [
        {
          "id": "uart-basics",
          "title": "UART 帧与波特率",
          "summary": "起始位、数据位、停止位，波特率与每秒字节数，TX 接 RX 交叉连线、共地",
          "estimated_minutes": 55,
          "lesson": "serial",
          "prerequisites": [
            {
              "all_of": [
                "mcu-architecture"
              ]
            }
          ]
        },
        {
          "id": "serial-logging",
          "title": "串口日志与调试",
          "summary": "打印状态与时间戳，日志节流，用日志定位状态转移",
          "estimated_minutes": 50,
          "lesson": "serial",
          "prerequisites": [
            {
              "all_of": [
                "uart-basics"
              ]
            }
          ]
        },
        {
          "id": "command-protocol",
          "title": "命令协议与解析",
          "summary": "按行分帧，命令与参数，校验输入长度，回包确认",
          "estimated_minutes": 80,
          "lesson": "serial",
          "prerequisites": [
            {
              "all_of": [
                "serial-logging"
              ]
            }
          ]
        },
        {
          "id": "comm-timeout",
          "title": "通信超时与重试",
          "summary": "等待回包的超时计时，有限次数重试，超时进入故障",
          "estimated_minutes": 60,
          "lesson": "serial",
          "prerequisites": [
            {
              "all_of": [
                "command-protocol",
                "nonblocking-timing"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "io-devices",
      "title": "传感器与执行器",
      "question_file": "questions/io-devices.json",
      "lessons": [
        {
          "id": "io-devices",
          "title": "传感器与执行器",
          "file": "lessons/io-devices.md"
        }
      ],
      "concepts": [
        {
          "id": "adc-reading",
          "title": "ADC 采样与换算",
          "summary": "分辨率 10/12 位，读数与电压换算 V=raw/max·Vref，参考电压",
          "estimated_minutes": 75,
          "lesson": "io-devices",
          "prerequisites": [
            {
              "all_of": [
                "logic-levels"
              ]
            }
          ]
        },
        {
          "id": "presence-sensors",
          "title": "到位传感器与光电开关",
          "summary": "对射与漫反射光电开关，NPN/PNP 输出，电平转换",
          "estimated_minutes": 55,
          "lesson": "io-devices",
          "prerequisites": [
            {
              "all_of": [
                "gpio-input"
              ]
            }
          ]
        },
        {
          "id": "servo-control",
          "title": "舵机 PWM 与角度",
          "summary": "50 Hz 周期，0.5–2.5 ms 脉宽对应角度，舵机独立供电",
          "estimated_minutes": 70,
          "lesson": "io-devices",
          "prerequisites": [
            {
              "all_of": [
                "timers-pwm"
              ]
            }
          ]
        },
        {
          "id": "driving-loads",
          "title": "负载驱动与隔离供电",
          "summary": "用三极管或 MOSFET 驱动继电器和电机，续流二极管，共地",
          "estimated_minutes": 55,
          "lesson": "io-devices",
          "prerequisites": [
            {
              "all_of": [
                "gpio-output"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "state-machines",
      "title": "状态机与可靠性",
      "question_file": "questions/state-machines.json",
      "lessons": [
        {
          "id": "state-machines",
          "title": "状态机与可靠性",
          "file": "lessons/state-machines.md"
        }
      ],
      "concepts": [
        {
          "id": "state-machine-design",
          "title": "状态、事件与转移表",
          "summary": "用 enum 表示状态，switch 处理事件，转移表，每个状态的进入动作",
          "estimated_minutes": 90,
          "lesson": "state-machines",
          "prerequisites": [
            {
              "all_of": [
                "edge-events",
                "nonblocking-timing"
              ]
            }
          ]
        },
        {
          "id": "fault-handling",
          "title": "故障状态与人工复位",
          "summary": "超时与异常进入故障，故障时输出安全状态，只有人工复位才离开故障",
          "estimated_minutes": 75,
          "lesson": "state-machines",
          "prerequisites": [
            {
              "all_of": [
                "state-machine-design"
              ]
            }
          ]
        },
        {
          "id": "watchdog-reset",
          "title": "看门狗与复位原因",
          "summary": "看门狗定时喂狗，程序卡死自动复位，读取复位原因",
          "estimated_minutes": 50,
          "lesson": "state-machines",
          "prerequisites": [
            {
              "all_of": [
                "fault-handling"
              ]
            }
          ]
        },
        {
          "id": "sorting-station-lab",
          "title": "实作：四状态分拣工位（自评）",
          "summary": "实现等待工件、等待判定、分流、故障四个状态，验证超时后保持故障直至人工复位。",
          "estimated_minutes": 110,
          "lesson": "state-machines",
          "prerequisites": [
            {
              "all_of": [
                "fault-handling",
                "comm-timeout",
                "servo-control",
                "presence-sensors"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "integration",
      "title": "系统集成与测试",
      "question_file": "questions/integration.json",
      "lessons": [
        {
          "id": "integration",
          "title": "系统集成与测试",
          "file": "lessons/integration.md"
        }
      ],
      "concepts": [
        {
          "id": "io-map",
          "title": "需求与 IO 分配表",
          "summary": "列出输入输出、引脚、电平、上下拉与安全默认值",
          "estimated_minutes": 60,
          "lesson": "integration",
          "prerequisites": [
            {
              "all_of": [
                "gpio-input",
                "gpio-output"
              ]
            }
          ]
        },
        {
          "id": "sensor-filtering",
          "title": "传感器滤波与迟滞",
          "summary": "多次采样平均，中值滤波，阈值迟滞避免抖动",
          "estimated_minutes": 75,
          "lesson": "integration",
          "prerequisites": [
            {
              "all_of": [
                "adc-reading"
              ]
            }
          ]
        },
        {
          "id": "integration-testing",
          "title": "分模块联调与测试记录",
          "summary": "先单独测输入、输出、通信再联调，测试用例与预期记录",
          "estimated_minutes": 75,
          "lesson": "integration",
          "prerequisites": [
            {
              "all_of": [
                "serial-logging",
                "state-machine-design"
              ]
            }
          ]
        },
        {
          "id": "power-up-behavior",
          "title": "上电、掉电与安全默认状态",
          "summary": "上电时引脚默认状态，初始化顺序，掉电恢复后进入安全状态",
          "estimated_minutes": 55,
          "lesson": "integration",
          "prerequisites": [
            {
              "all_of": [
                "watchdog-reset"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
    "palace_planning_instructions": "profiles/palace-planning.txt",
    "palace_research_instructions": "profiles/palace-research.txt"
  },
  "description": "用 GPIO、串口和状态机驱动一个可复位的桌面分拣工位。",
  "roadmap": {
    "note": "先学电路基础与 C 语言的条件、循环和函数。",
    "prerequisites": [
      {
        "all_of": [
          "circuit-fundamentals",
          "c-programming"
        ],
        "strength": "required"
      }
    ]
  }
}
