      {
        "type": "text",
        "text": "The truck needs repairs, so today's delivery has been moved to Friday at ten in the morning. Please confirm that someone will be available to receive the boxes at that time. I'm sorry for the change and thank you for your help.",
        "tts": { "voice": "stella" }
      },
      { "type": "text", "text": "\n\n" },
      {
        "type": "text",
        "text": "Best,\nSam",
        "tts": { "voice": "stella", "text": "Best, Sam" }
      }
