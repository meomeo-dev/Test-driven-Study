    "analysis": [
      { "type": "text", "text": "先用 " },
      { "type": "text", "text": "so", "tts": { "voice": "stella" } },
      { "type": "text", "text": " 连接改期原因和新时间，再用 " },
      { "type": "text", "text": "Please confirm", "tts": { "voice": "stella" } },
      { "type": "text", "text": " 礼貌地请同事确认收货安排。称呼和落款让邮件格式完整。" }
    ]
  },
