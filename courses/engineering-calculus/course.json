          "file": "lessons/derivatives.md"
        }
      ],
      "concepts": [
        {
          "id": "derivative-definition",
          "title": "导数的定义与意义",
          "summary": "f'(x) = lim (f(x+h) − f(x))/h，瞬时变化率，切线斜率，单位",
          "estimated_minutes": 75,
          "lesson": "derivatives",
          "prerequisites": [
            {
              "all_of": [
                "limits"
              ]
            }
          ]
        },
        {
          "id": "derivative-rules",
          "title": "求导法则",
          "summary": "幂函数、常数倍、和差、乘积与商的求导法则",
          "estimated_minutes": 85,
          "lesson": "derivatives",
          "prerequisites": [
            {
              "all_of": [
                "derivative-definition"
              ]
            }
          ]
        },
        {
          "id": "chain-rule",
          "title": "复合函数求导",
          "summary": "链式法则 dy/dx = dy/du · du/dx，识别内层与外层函数",
          "estimated_minutes": 75,
          "lesson": "derivatives",
          "prerequisites": [
            {
              "all_of": [
                "derivative-rules"
              ]
            }
          ]
        },
        {
          "id": "transcendental-derivatives",
          "title": "指数、对数与三角函数的导数",
          "summary": "(eˣ)' = eˣ，(ln x)' = 1/x，(sin x)' = cos x，(cos x)' = −sin x，与链式法则结合",
          "estimated_minutes": 70,
          "lesson": "derivatives",
          "prerequisites": [
            {
              "all_of": [
                "chain-rule"
              ]
            }
          ]
        }
      ]
    },
