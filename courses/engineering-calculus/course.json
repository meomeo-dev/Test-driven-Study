          "estimated_minutes": 70,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "average-rate"
              ]
            }
          ]
        },
        {
          "id": "continuity",
          "title": "连续性",
          "summary": "连续的含义，间断点，分段函数在分界点处的连续性",
