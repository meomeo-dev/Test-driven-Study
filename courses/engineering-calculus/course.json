      "concepts": [
        {
          "id": "functions-review",
          "title": "函数与常见函数",
          "summary": "定义域与值域，多项式、指数、对数、正弦函数的图像与性质，复合函数",
          "estimated_minutes": 60,
          "lesson": "intro"
        },
        {
          "id": "average-rate",
          "title": "平均变化率",
          "summary": "Δy/Δx，割线斜率，平均速度 = 位移/时间，由数据表计算",
          "estimated_minutes": 55,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "functions-review"
              ]
            }
          ]
