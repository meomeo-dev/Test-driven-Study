    {
      "id": "design-for-printing",
      "title": "面向打印的设计",
      "question_file": "questions/design-for-printing.json",
      "lessons": [
        {
          "id": "design-for-printing",
          "title": "面向打印的设计",
          "file": "lessons/design-for-printing.md"
        }
      ],
      "concepts": [
        {
          "id": "dfam-rules",
          "title": "面向 FDM 的设计规则",
          "summary": "最小壁厚为线宽的整数倍，避免大悬垂，竖直孔与水平孔，倒角代替底部圆角",
          "estimated_minutes": 70,
          "lesson": "design-for-printing",
          "prerequisites": [
            {
              "all_of": [
                "supports-orientation",
                "fillets-chamfers"
              ]
            }
          ]
        },
        {
          "id": "clearance-test",
          "title": "间隙试片与孔径补偿",
          "summary": "孔通常打小、轴通常打大，配合间隙，试片法确定补偿量",
          "estimated_minutes": 80,
          "lesson": "design-for-printing",
          "prerequisites": [
            {
              "all_of": [
                "dfam-rules"
              ]
            }
          ]
        },
        {
          "id": "print-defects",
          "title": "常见打印缺陷与排查",
          "summary": "翘边、拉丝、层错位、象脚、欠挤出与过挤出的原因与处理",
          "estimated_minutes": 70,
          "lesson": "design-for-printing",
          "prerequisites": [
            {
              "all_of": [
                "printer-setup",
                "speed-temperature"
              ]
            }
          ]
        },
        {
          "id": "part-measurement",
          "title": "打印件测量与记录",
          "summary": "用卡尺测量孔径与外形，记录打印方向、材料和实测尺寸，比较设计值与实测值",
          "estimated_minutes": 60,
          "lesson": "design-for-printing",
          "prerequisites": [
            {
              "all_of": [
                "clearance-test"
              ]
            }
          ]
        },
        {
          "id": "post-processing",
          "title": "后处理与热熔螺母",
          "summary": "去支撑与修边，热熔铜螺母孔径，自攻螺钉孔",
          "estimated_minutes": 50,
          "lesson": "design-for-printing",
          "prerequisites": [
            {
              "all_of": [
                "dfam-rules"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "fixtures",
      "title": "定位夹具",
      "question_file": "questions/fixtures.json",
      "lessons": [
        {
          "id": "fixtures",
          "title": "定位夹具",
          "file": "lessons/fixtures.md"
        }
      ],
      "concepts": [
        {
          "id": "locating-principles",
          "title": "定位原理与基准面",
          "summary": "六点定位与 3-2-1 原则，欠定位与过定位，定位面与夹紧方向",
