      "lessons": [
        {
          "id": "fdm-basics",
          "title": "FDM 原理与材料",
          "file": "lessons/fdm-basics.md"
        }
      ],
      "concepts": [
        {
          "id": "fdm-process",
          "title": "FDM 工作原理",
          "summary": "挤出机、热端、喷嘴、热床，逐层堆积，挤出线宽与层高",
          "estimated_minutes": 60,
          "lesson": "fdm-basics"
        },
        {
          "id": "materials",
          "title": "常用材料与选用",
          "summary": "PLA、PETG、ABS、TPU 的打印温度、强度、耐热与收缩，受潮",
