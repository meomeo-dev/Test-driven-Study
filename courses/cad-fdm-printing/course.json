          "id": "base-plate-lab",
          "title": "定位底板与间隙试片（自评）",
          "summary": "设计带两个安装孔和定位基准面的底板，先打印三组不同孔径的试片选定孔径，再打印底板并把同一工件取放 20 次检查是否每次贴紧基准面。",
          "estimated_minutes": 110,
          "lesson": "fixtures",
          "prerequisites": [
            {
              "all_of": [
                "fixture-design",
                "clearance-test"
              ]
            }
          ]
        }
