          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "cad-workflow",
          "title": "参数化建模流程",
          "summary": "草图到特征到零件的流程，特征历史树，设计意图，修改尺寸后模型自动更新",
          "estimated_minutes": 60,
          "lesson": "intro"
        },
        {
          "id": "sketch-geometry",
          "title": "草图与几何元素",
          "summary": "草图平面，直线、圆、圆弧、矩形，构造线，闭合轮廓",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "cad-workflow"
              ]
            }
          ]
        },
        {
          "id": "sketch-constraints",
          "title": "几何约束",
          "summary": "重合、水平、竖直、平行、垂直、相切、同心、对称、相等约束",
          "estimated_minutes": 80,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "sketch-geometry"
