      "title": "特征建模",
      "question_file": "questions/features.json",
      "lessons": [
        {
          "id": "features",
          "title": "特征建模",
          "file": "lessons/features.md"
        }
      ],
      "concepts": [
        {
          "id": "extrude-revolve",
          "title": "拉伸与旋转",
          "summary": "拉伸长度与方向，拉伸切除，旋转特征与旋转轴",
          "estimated_minutes": 70,
          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "dimension-constraints"
              ]
