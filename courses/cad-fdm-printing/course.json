          "lesson": "fdm-basics",
          "prerequisites": [
            {
              "all_of": [
                "fdm-process"
              ]
            }
          ]
        },
        {
          "id": "printer-setup",
          "title": "调平、首层与喷嘴",
          "summary": "热床调平，Z 偏移，首层附着，喷嘴直径与堵塞",
          "estimated_minutes": 65,
          "lesson": "fdm-basics",
          "prerequisites": [
            {
              "all_of": [
                "fdm-process"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "slicing",
      "title": "切片与参数",
      "question_file": "questions/slicing.json",
      "lessons": [
        {
          "id": "slicing",
          "title": "切片与参数",
          "file": "lessons/slicing.md"
        }
      ],
      "concepts": [
        {
          "id": "slicing-basics",
          "title": "切片流程与预览",
          "summary": "导入模型、摆放、切片、逐层预览、G-code，首层与支撑的检查",
          "estimated_minutes": 65,
          "lesson": "slicing",
          "prerequisites": [
            {
              "all_of": [
                "fdm-process",
                "drawings-export"
              ]
            }
          ]
        },
        {
