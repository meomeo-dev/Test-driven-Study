          "lesson": "features",
          "prerequisites": [
            {
              "all_of": [
                "extrude-revolve"
              ]
            }
          ]
        },
        {
          "id": "parameters-equations",
          "title": "参数表与设计变更",
          "summary": "命名参数与表达式，孔距等关键尺寸驱动模型，修改参数验证设计意图",
