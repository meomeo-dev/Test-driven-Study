          "title": "Python 入门与基本类型",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "run-scripts",
          "title": "运行脚本与 print",
          "summary": "解释器与 .py 脚本，print 输出多个值与 sep，注释，出错时读 Traceback 最后一行",
          "estimated_minutes": 50,
          "lesson": "intro"
        },
        {
          "id": "variables-types",
          "title": "变量与基本类型",
          "summary": "int、float、str、bool，type()，赋值与重新赋值，变量命名规则",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "run-scripts"
              ]
            }
          ]
        },
        {
          "id": "arithmetic",
          "title": "算术运算与类型转换",
          "summary": "+ - * / // % ** 与优先级，/ 总得 float，int()/float()/str() 转换，round()",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "variables-types"
