{
  "protocol_version": 1,
  "course_id": "probability-statistics",
  "version": "1.1.0",
  "title": "概率论与数理统计",
  "language": "zh-CN",
  "units": [
    {
      "id": "intro",
      "title": "数据与描述统计",
      "question_file": "questions/intro.json",
      "lessons": [
        {
          "id": "intro",
          "title": "数据与描述统计",
          "file": "lessons/intro.md"
        }
      ],
      "concepts": [
        {
          "id": "data-types",
          "title": "数据类型与测量尺度",
          "summary": "定性数据与定量数据，离散与连续，名义、顺序、区间、比率尺度",
          "estimated_minutes": 50,
          "lesson": "intro"
        },
        {
          "id": "descriptive-means",
          "title": "均值与加权平均",
          "summary": "算术平均，加权平均，均值受极端值影响",
          "estimated_minutes": 55,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "data-types"
              ]
            }
          ]
        },
        {
          "id": "central-tendency",
          "title": "中位数、众数与集中趋势",
          "summary": "中位数和众数的求法，偏态时均值与中位数的关系，选择合适的集中趋势指标",
          "estimated_minutes": 60,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "descriptive-means"
              ]
            }
          ]
        },
        {
          "id": "dispersion",
          "title": "极差、方差与标准差",
          "summary": "极差，样本方差 s² = Σ(x − x̄)²/(n − 1)，标准差，变异系数",
          "estimated_minutes": 80,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "descriptive-means"
              ]
            }
          ]
        },
        {
          "id": "distribution-shape",
          "title": "直方图、四分位数与箱线图",
          "summary": "分组与直方图，偏态与双峰，四分位数，四分位距 IQR，箱线图与 1.5·IQR 离群点",
          "estimated_minutes": 65,
          "lesson": "intro",
          "prerequisites": [
            {
              "all_of": [
                "central-tendency"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "probability",
      "title": "概率基础",
      "question_file": "questions/probability.json",
      "lessons": [
        {
          "id": "probability",
          "title": "概率基础",
          "file": "lessons/probability.md"
        }
      ],
      "concepts": [
        {
          "id": "sample-spaces",
          "title": "样本空间与事件",
          "summary": "随机试验，样本空间，事件的并、交、补，互斥事件",
          "estimated_minutes": 55,
          "lesson": "probability"
        },
        {
          "id": "counting",
          "title": "排列与组合",
          "summary": "乘法原理，排列 P(n, k)，组合 C(n, k)，从一批零件中抽取的组合数",
          "estimated_minutes": 60,
          "lesson": "probability",
          "prerequisites": [
            {
              "all_of": [
                "sample-spaces"
              ]
            }
          ]
        },
        {
          "id": "probability-rules",
          "title": "概率的运算法则",
          "summary": "古典概率，加法公式 P(A∪B) = P(A) + P(B) − P(A∩B)，补事件",
          "estimated_minutes": 70,
          "lesson": "probability",
          "prerequisites": [
            {
              "all_of": [
                "sample-spaces"
              ]
            }
          ]
        },
        {
          "id": "conditional-probability",
          "title": "条件概率与独立",
          "summary": "P(A|B) = P(A∩B)/P(B)，乘法公式，独立事件的判断与计算",
          "estimated_minutes": 80,
          "lesson": "probability",
          "prerequisites": [
            {
              "all_of": [
                "probability-rules"
              ]
            }
          ]
        },
        {
          "id": "bayes",
          "title": "全概率公式与贝叶斯公式",
          "summary": "全概率公式，贝叶斯公式，检测报警时工件真有缺陷的概率，基础比率",
          "estimated_minutes": 80,
          "lesson": "probability",
          "prerequisites": [
            {
              "all_of": [
                "conditional-probability"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "distributions",
      "title": "随机变量与分布",
      "question_file": "questions/distributions.json",
      "lessons": [
        {
          "id": "distributions",
          "title": "随机变量与分布",
          "file": "lessons/distributions.md"
        }
      ],
      "concepts": [
        {
          "id": "random-variables",
          "title": "随机变量与期望",
          "summary": "离散随机变量与分布列，期望 E(X)，方差 Var(X)，期望的线性性质",
          "estimated_minutes": 70,
          "lesson": "distributions",
          "prerequisites": [
            {
              "all_of": [
                "probability-rules"
              ]
            }
          ]
        },
        {
          "id": "binomial",
          "title": "二项分布",
          "summary": "独立重复试验，P(X = k) = C(n, k)pᵏ(1 − p)ⁿ⁻ᵏ，期望 np，方差 np(1 − p)",
          "estimated_minutes": 70,
          "lesson": "distributions",
          "prerequisites": [
            {
              "all_of": [
                "random-variables",
                "counting"
              ]
            }
          ]
        },
        {
          "id": "poisson",
          "title": "泊松分布",
          "summary": "单位时间或单位面积的缺陷数，P(X = k) = λᵏe^(−λ)/k!，期望和方差都等于 λ",
          "estimated_minutes": 55,
          "lesson": "distributions",
          "prerequisites": [
            {
              "all_of": [
                "binomial"
              ]
            }
          ]
        },
        {
          "id": "normal",
          "title": "正态分布与 z 分数",
          "summary": "正态曲线，μ 和 σ 的含义，z = (x − μ)/σ，68–95–99.7 规则，查表求概率",
          "estimated_minutes": 85,
          "lesson": "distributions",
          "prerequisites": [
            {
              "all_of": [
                "random-variables",
                "dispersion"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sampling",
      "title": "抽样与抽样分布",
      "question_file": "questions/sampling.json",
      "lessons": [
        {
          "id": "sampling",
          "title": "抽样与抽样分布",
          "file": "lessons/sampling.md"
        }
      ],
      "concepts": [
        {
          "id": "sampling-methods",
          "title": "总体、样本与抽样偏差",
          "summary": "总体与样本，简单随机抽样、分层抽样，抽样偏差与代表性，跨批次抽样",
          "estimated_minutes": 60,
          "lesson": "sampling",
          "prerequisites": [
            {
              "all_of": [
                "data-types"
              ]
            }
          ]
        },
        {
          "id": "sampling-distribution",
          "title": "样本均值的抽样分布",
          "summary": "样本均值的期望为 μ，标准误 σ/√n，样本量与估计精度",
          "estimated_minutes": 80,
          "lesson": "sampling",
          "prerequisites": [
            {
              "all_of": [
                "normal",
                "sampling-methods"
              ]
            }
          ]
        },
        {
          "id": "central-limit",
          "title": "中心极限定理",
          "summary": "样本量足够大时样本均值近似正态，适用条件与常见误解",
          "estimated_minutes": 60,
          "lesson": "sampling",
          "prerequisites": [
            {
              "all_of": [
                "sampling-distribution"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inference",
      "title": "估计与检验",
      "question_file": "questions/inference.json",
      "lessons": [
        {
          "id": "inference",
          "title": "估计与检验",
          "file": "lessons/inference.md"
        }
      ],
      "concepts": [
        {
          "id": "point-estimation",
          "title": "点估计",
          "summary": "用样本均值、样本比例、样本标准差估计总体参数，无偏的含义",
          "estimated_minutes": 55,
          "lesson": "inference",
          "prerequisites": [
            {
              "all_of": [
                "sampling-distribution"
              ]
            }
          ]
        },
        {
          "id": "confidence-intervals",
          "title": "置信区间",
          "summary": "均值的置信区间 x̄ ± z·σ/√n，置信水平的正确解释，区间宽度与样本量",
          "estimated_minutes": 85,
          "lesson": "inference",
          "prerequisites": [
            {
              "all_of": [
                "point-estimation",
                "central-limit"
              ]
            }
          ]
        },
        {
          "id": "hypothesis-testing",
          "title": "假设检验入门",
          "summary": "原假设与备择假设，检验统计量，p 值，显著性水平，第一类与第二类错误",
          "estimated_minutes": 85,
          "lesson": "inference",
          "prerequisites": [
            {
              "all_of": [
                "confidence-intervals"
              ]
            }
          ]
        },
        {
          "id": "proportion-inference",
          "title": "比例的估计",
          "summary": "不良率 p̂ 的置信区间 p̂ ± z·√(p̂(1 − p̂)/n)，所需样本量的估计",
          "estimated_minutes": 65,
          "lesson": "inference",
          "prerequisites": [
            {
              "all_of": [
                "confidence-intervals",
                "binomial"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "regression",
      "title": "相关与回归",
      "question_file": "questions/regression.json",
      "lessons": [
        {
          "id": "regression",
          "title": "相关与回归",
          "file": "lessons/regression.md"
        }
      ],
      "concepts": [
        {
          "id": "scatter-correlation",
          "title": "散点图与相关系数",
          "summary": "散点图，相关系数 r 的范围与含义，相关不等于因果",
          "estimated_minutes": 70,
          "lesson": "regression",
          "prerequisites": [
            {
              "all_of": [
                "dispersion"
              ]
            }
          ]
        },
        {
          "id": "linear-regression",
          "title": "一元线性回归",
          "summary": "最小二乘直线 ŷ = a + bx，斜率 b = Σ(x − x̄)(y − ȳ)/Σ(x − x̄)²，残差，用回归作预测的范围",
          "estimated_minutes": 85,
          "lesson": "regression",
          "prerequisites": [
            {
              "all_of": [
                "scatter-correlation"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "quality-data",
      "title": "质量数据应用",
      "question_file": "questions/quality-data.json",
      "lessons": [
        {
          "id": "quality-data",
          "title": "质量数据应用",
          "file": "lessons/quality-data.md"
        }
      ],
      "concepts": [
        {
          "id": "control-charts",
          "title": "控制图入门",
          "summary": "均值图，中心线与 ±3σ 控制限，判异规则，过程稳定与合格是两回事",
          "estimated_minutes": 80,
          "lesson": "quality-data",
          "prerequisites": [
            {
              "all_of": [
                "sampling-distribution"
              ]
            }
          ]
        },
        {
          "id": "measurement-variation",
          "title": "测量波动与重复性",
          "summary": "件间差异与重复测量差异，用同一件重复测量估计测量波动",
          "estimated_minutes": 70,
          "lesson": "quality-data",
          "prerequisites": [
            {
              "all_of": [
                "dispersion"
              ]
            }
          ]
        },
        {
          "id": "variation-lab",
          "title": "打印件尺寸波动分析（自评）",
          "summary": "测量 10 个不同打印件和同一件重复 10 次，画两组直方图，比较标准差并解释件间差异与测量波动。",
          "estimated_minutes": 70,
          "lesson": "quality-data",
          "prerequisites": [
            {
              "all_of": [
                "measurement-variation",
                "distribution-shape"
              ]
            }
          ]
        }
      ]
    }
  ],
  "ai_profile": {
    "palace_template": "profiles/memory-palace.json",
    "palace_planning_instructions": "profiles/palace-planning.txt",
    "palace_research_instructions": "profiles/palace-research.txt"
  },
  "description": "从尺寸读数、抽样和变异判断质量数据是否稳定。",
  "roadmap": {
    "note": "系统学习概率分布与估计时再配合高数。",
    "parallel_with": [
      "engineering-calculus"
    ]
  }
}
