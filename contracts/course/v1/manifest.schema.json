{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.example/contracts/course/v1/manifest.schema.json",
  "type": "object",
  "required": ["protocol_version", "course_id", "version", "title", "language", "units"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": 1 },
    "course_id": { "$ref": "#/$defs/slug" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "title": { "$ref": "#/$defs/text" },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$" },
    "description": { "type": "string" },
    "logo": { "$ref": "#/$defs/path" },
    "ai_profile": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "assistant_instructions": { "$ref": "#/$defs/path" },
        "palace_template": { "$ref": "#/$defs/path" },
        "palace_planning_instructions": { "$ref": "#/$defs/path" },
        "palace_research_instructions": { "$ref": "#/$defs/path" }
      }
    },
    "roadmap": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["all_of", "strength"],
            "additionalProperties": false,
            "properties": {
              "all_of": { "$ref": "#/$defs/courseList" },
              "strength": { "enum": ["required", "recommended"] }
            }
          }
        },
        "parallel_with": { "$ref": "#/$defs/courseList" }
      },
      "anyOf": [
        { "required": ["prerequisites"] },
        { "required": ["parallel_with"] }
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "$ref": "#/$defs/text" },
          "question_file": { "$ref": "#/$defs/path" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "file"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "$ref": "#/$defs/text" },
                "file": { "$ref": "#/$defs/path" }
              }
            }
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/concept" }
          }
        },
        "anyOf": [
          { "required": ["question_file"] },
          { "required": ["lessons"] }
        ]
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512 },
    "courseList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "concept": {
      "type": "object",
      "required": ["id", "title", "estimated_minutes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1, "maximum": 600 },
        "lesson": { "$ref": "#/$defs/slug" },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["all_of"],
            "additionalProperties": false,
            "properties": {
              "all_of": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/slug" }
              }
            }
          }
        }
      }
    }
  }
}
