{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.example/contracts/course/v1/items.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "type", "stem", "grading"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["single_choice", "multiple_choice", "true_false", "numeric"] },
      "stem": { "$ref": "#/$defs/text" },
      "explanation": { "type": "string" },
      "hint": { "type": "string" },
      "chapter": { "type": "string" },
      "concepts": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/slug" }
      },
      "image": { "type": "string", "minLength": 1, "maxLength": 512 },
      "audio": { "type": "string", "minLength": 1, "maxLength": 512 },
      "transcript": { "type": "string", "minLength": 1, "maxLength": 512 },
      "options": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "text": { "$ref": "#/$defs/text" },
            "value": { "type": "boolean" }
          }
        }
      },
      "grading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "choice_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "boolean": { "type": "boolean" },
          "value": { "$ref": "#/$defs/decimal" },
          "absolute_tolerance": { "$ref": "#/$defs/decimal" }
        }
      }
    },
    "dependentRequired": { "transcript": ["audio"] },
    "oneOf": [
      {
        "required": ["options"],
        "properties": {
          "type": { "const": "single_choice" },
          "grading": {
            "required": ["choice_ids"],
            "maxProperties": 1,
            "properties": { "choice_ids": { "minItems": 1, "maxItems": 1 } }
          }
        }
      },
      {
        "required": ["options"],
        "properties": {
          "type": { "const": "multiple_choice" },
          "grading": {
            "required": ["choice_ids"],
            "maxProperties": 1,
            "properties": { "choice_ids": { "minItems": 2 } }
          }
        }
      },
      {
        "properties": {
          "type": { "const": "true_false" },
          "options": {
            "maxItems": 2,
            "items": { "required": ["value"] }
          },
          "grading": { "required": ["boolean"], "maxProperties": 1 }
        }
      },
      {
        "not": { "required": ["options"] },
        "properties": {
          "type": { "const": "numeric" },
          "grading": { "required": ["value", "absolute_tolerance"], "maxProperties": 2 }
        }
      }
    ]
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9]+([_-][a-zA-Z0-9]+)*$" },
    "slug": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "decimal": { "type": "string", "maxLength": 64, "pattern": "^-?[0-9]+(\\.[0-9]+)?$" }
  }
}
