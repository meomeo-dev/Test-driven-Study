{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.example/contracts/course/v1/items.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "type", "stem", "grading"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["single_choice", "multiple_choice", "true_false", "numeric"] },
      "stem": { "$ref": "#/$defs/richContent" },
      "explanation": { "type": "string" },
      "hint": { "type": "string" },
      "chapter": { "type": "string" },
      "concepts": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/slug" }
      },
      "image": { "type": "string", "minLength": 1, "maxLength": 512 },
      "audio": { "type": "string", "minLength": 1, "maxLength": 512 },
      "transcript": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 512 },
          {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/transcriptLine" }
          }
        ]
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "text": { "$ref": "#/$defs/text" },
            "value": { "type": "boolean" },
            "tts": {
              "oneOf": [
                { "type": "boolean" },
                { "$ref": "#/$defs/ttsConfig" }
              ]
            }
          }
        }
      },
      "grading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "choice_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "boolean": { "type": "boolean" },
          "value": { "$ref": "#/$defs/decimal" },
          "absolute_tolerance": { "$ref": "#/$defs/decimal" }
        }
      }
    },
    "oneOf": [
      {
        "required": ["options"],
        "properties": {
          "type": { "const": "single_choice" },
          "grading": {
            "required": ["choice_ids"],
            "maxProperties": 1,
            "properties": { "choice_ids": { "minItems": 1, "maxItems": 1 } }
          }
        }
      },
      {
        "required": ["options"],
        "properties": {
          "type": { "const": "multiple_choice" },
          "grading": {
            "required": ["choice_ids"],
            "maxProperties": 1,
            "properties": { "choice_ids": { "minItems": 2 } }
          }
        }
      },
      {
        "properties": {
          "type": { "const": "true_false" },
          "options": {
            "maxItems": 2,
            "items": { "required": ["value"] }
          },
          "grading": { "required": ["boolean"], "maxProperties": 1 }
        }
      },
      {
        "not": { "required": ["options"] },
        "properties": {
          "type": { "const": "numeric" },
          "grading": { "required": ["value", "absolute_tolerance"], "maxProperties": 2 }
        }
      }
    ]
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9]+([_-][a-zA-Z0-9]+)*$" },
    "slug": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "decimal": { "type": "string", "maxLength": 64, "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
    "ttsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice": { "enum": ["stella", "tide"] },
        "text": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      }
    },
    "contentSegment": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["text", "speech", "blank"] },
        "text": { "type": "string" },
        "tts": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/ttsConfig" }
          ]
        },
        "index": { "type": "integer", "minimum": 1 }
      }
    },
    "richContent": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentSegment" }
        }
      ]
    },
    "transcriptLine": {
      "type": "object",
      "required": ["speaker", "text"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string", "minLength": 1, "maxLength": 64 },
        "text": { "$ref": "#/$defs/text" },
        "tts": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/ttsConfig" }
          ]
        }
      }
    }
  }
}
