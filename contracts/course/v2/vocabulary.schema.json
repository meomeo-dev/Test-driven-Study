{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://study.example/contracts/course/v2/vocabulary.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "unit_id", "term", "meaning", "category"],
    "properties": {
      "id": {"$ref": "../v1/manifest.schema.json#/$defs/slug"},
      "unit_id": {"$ref": "../v1/manifest.schema.json#/$defs/slug"},
      "term": {"$ref": "../v1/items.schema.json#/$defs/text"},
      "meaning": {"$ref": "../v1/items.schema.json#/$defs/text"},
      "category": {
        "enum": ["word", "word_group", "phrase", "collocation", "idiom", "function_phrase"]
      },
      "question_ids": {
        "type": "array",
        "uniqueItems": true,
        "items": {"$ref": "../v1/items.schema.json#/$defs/id"}
      },
      "example": {"$ref": "../v1/items.schema.json#/$defs/text"},
      "example_translation": {"$ref": "../v1/items.schema.json#/$defs/text"}
    },
    "dependentRequired": {
      "example": ["example_translation"],
      "example_translation": ["example"]
    }
  }
}
