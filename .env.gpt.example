# Separate Responses API bootstrap. Copy to .env.gpt and fill locally.
# Saved LLM settings take precedence. Never reuse the image-provider key here.
GPT_1_BASE_URL=https://api.openai.com/v1
GPT_1_API_KEY=
GPT_1_MODELS=gpt-5.5
# Optional default; must be included in GPT_1_MODELS. Otherwise the first is used.
GPT_1_DEFAULT_MODEL=gpt-5.5
GPT_1_PROXY_URL=
# default omits reasoning; supported values depend on the selected model.
GPT_1_REASONING_EFFORT=medium
# 1 K = 1024 tokens. Output and working context are separate limits.
# Legacy API override only; normal output allocation follows reserve below.
# GPT_1_MAX_OUTPUT_TOKENS_K=64
GPT_1_CONTEXT_BUDGET_K=274
GPT_1_COMPACT_THRESHOLD_K=210
GPT_1_COMPACT_RESERVE_K=64
# required needs real built-in web_search and traceable government sources.
# off is explicit unverified mode, never an automatic fallback.
GPT_1_WEB_SEARCH=required
